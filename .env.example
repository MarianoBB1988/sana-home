# Copiá este archivo como .env y completá los valores.

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b
GROQ_MODELO_BUSQUEDA=openai/gpt-oss-20b
GROQ_MODELO_STT=whisper-large-v3-turbo

# --- Asistente ---
NOMBRE=Sana
CIUDAD=Montevideo, Uruguay
ZONA_HORARIA=America/Montevideo

# --- Clima (opcional) ---
# Sin clave ya funcionan Open-Meteo (varios modelos) y MET Norway. Con estas claves se habilitan más
# fuentes en Ajustes > Clima. Todas tienen plan gratuito (AccuWeather: ~50 consultas por día).
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
GOOGLE_WEATHER_API_KEY=
ACCUWEATHER_API_KEY=

# --- Home Assistant (opcional: sin esto, Sana conversa y busca pero no controla dispositivos) ---
# URL, por ejemplo http://192.168.1.50:8123
HA_URL=
# Token de larga duración: Perfil > Seguridad > Tokens de acceso de larga duración
HA_TOKEN=

# --- Audio ---
# Motor de voz: "edge" (voz neural de Microsoft, necesita internet; Piper queda de respaldo) o "piper" (100% local)
MOTOR_VOZ=edge
# Voces uruguayas: es-UY-ValentinaNeural (mujer) o es-UY-MateoNeural (hombre). Lista: python -m edge_tts --list-voices
VOZ_EDGE=es-UY-ValentinaNeural
# Archivo de voz de Piper (se descarga con: python -m piper.download_voices --download-dir voces es_ES-davefx-medium)
# Las voces "medium" son ~5 veces más rápidas que las "high". Muestras en voces/muestras/.
VOZ_PIPER=voces/es_ES-davefx-medium.onnx
# Para voces con varios hablantes (es_ES-sharvard-medium: 0 o 1)
VOZ_HABLANTE=0
# Índice o parte del nombre del dispositivo (ver: python main.py --dispositivos). Vacío = el predeterminado.
MICROFONO=
PARLANTE=
# Segundos de silencio antes de hablar: evita que los parlantes Bluetooth se coman la primera palabra.
SILENCIO_INICIAL=0.3
